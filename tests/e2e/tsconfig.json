// TYPECHECK-ONLY config for the Playwright e2e tree (`npm run build:test`
// runs it after the Mocha build). Playwright's own runner TRANSPILES specs
// without ever type-checking them, so before this config existed the e2e
// tree was invisible to tsc entirely — a widened union (floodgateSteel), a
// renamed helper or a mis-placed import rotted silently until the spec was
// actually RUN, hours or days later. `noEmit`: Playwright still does its own
// transpilation; this is a gate, not a build.
{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        // The base config is incremental for the real builds; a noEmit gate
        // writes no .tsbuildinfo worth keeping.
        "incremental": false,
        "types": ["node"]
    },
    "include": [
        "./**/*.ts",
        // The harness's config lives at the repo root but belongs to this tree (it imports `TIMING_SPECS` from it):
        // the product checker excludes it (webpack.config.js), so THIS gate is where it is type-checked.
        "../../playwright.config.ts"
    ]
}
