{
    "compilerOptions": {
        "outDir": "../build/tests",
        "types": ["node", "mocha", "chai"],
        // A MANDATORY GATE IS NEVER INCREMENTAL. The base config is incremental for the real builds; inherited
        // here, `--noEmit` reused the root .tsbuildinfo and re-reported a spec's CACHED diagnostics until some
        // unrelated model change happened to invalidate it — `parliamentRewardBeat.spec.ts` carried a TS2532 for
        // a whole session of green `build:test` runs (2026-09-24). The e2e config below already says the same.
        "incremental": false
    },
    "extends": "../tsconfig.json",
    "include": [
        "testing/setup.ts",
        "**/*.spec.ts",
        "vue-shims.d.ts"
    ],
    // E2E specs use @playwright/test (its own runner/types) and are compiled by
    // Playwright, not by the Mocha/tsc test build. They are TYPE-CHECKED by
    // their own noEmit config (tests/e2e/tsconfig.json), chained into
    // `npm run build:test` — Playwright transpiles without checking, so
    // without that gate the e2e tree rots silently (the floodgateSteel
    // payment-literal rot went unnoticed until the specs were RUN).
    "exclude": [
        "e2e"
    ]
}
