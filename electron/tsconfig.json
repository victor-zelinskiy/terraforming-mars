{
  // THE ELECTRON MAIN PROCESS'S TYPE CHECK — `npm run typecheck`. Nothing is emitted: the main process and its preloads
  // are bundled by Vite (`node scripts/build-node.mts electron` → build/electron/, docs/claude/stack.md). Isolated from
  // the server check (src/tsconfig.json) and the renderer's (tsconfig.vue-tsc.json): electron/*.ts import only from
  // 'electron', `velopack` and Node built-ins (the hub's two types are declared again in diagnosticsHost.ts).
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
